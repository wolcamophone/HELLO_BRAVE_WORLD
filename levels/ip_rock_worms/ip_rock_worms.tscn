[node name="WorldSpaceInfo" type="Node" parent="."]
script = ExtResource("21_12fyr")
lvl_title = "Rock Worms"
lvl_description = "Rock worms of blue with orange teeth like zipper. They burrow through solid rock from deep underground to the surface of urban locations, never moving while being observed directly, though still very much noticeable when the ground shakes as they move at incredible speed. The size of the worm is variable. You look into its mouth and may see a tunnel to a cozy and favorite location at first, but it soon turns off and transitions into an endless rock cave in either direction that gets thinner as you run down."
default_spawn_position = Vector4(-51, 0, 36, 90)
